{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "@coin-archive/db#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/deploy-production.yml",
        "$TURBO_ROOT$/.github/workflows/deploy-staging.yml"
      ]
    },
    "@coin-archive/staging-verification#test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
