{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @coin-archive/api build",
    "dev": "vite dev --port 3000",
    "dev:staging": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@coin-archive/api": "workspace:*",
    "@coin-archive/ui": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/eslint-config": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "jsdom": "^30.0.1",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^5.0.0"
  }
}
