{
  "name": "coin-archive",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build --cache-dir .turbo/cache",
    "db:smoke": "node ./scripts/db-smoke.mjs",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck --cache-dir .turbo/cache",
    "db:reset": "docker compose down --volumes",
    "db:start": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:seed": "pnpm --filter @workspace/db run seed",
    "db:studio": "pnpm --filter @workspace/db run studio",
    "sandcastle": "pnpm exec tsx .sandcastle/main.mts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.15",
    "typescript": "^6",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
