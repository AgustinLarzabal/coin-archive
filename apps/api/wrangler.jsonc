{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coin-archive-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "DATABASE_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
    ],
  },
  "vars": {
    "API_ENVIRONMENT": "staging",
    "BETTER_AUTH_TRUSTED_ORIGINS": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://127.0.0.1:8787",
    "SURFACE_IMAGE_ORIGIN": "http://localhost:3000",
    "R2_BUCKET": "coin-archive-staging-surface-images",
    "R2_ENDPOINT": "https://51b6c859d0c0db14fc10e144dd033d2b.r2.cloudflarestorage.com",
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "242",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "MAINTENANCE_READ_RATE_LIMITER",
      "namespace_id": "244",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "MAINTENANCE_MUTATION_RATE_LIMITER",
      "namespace_id": "245",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 },
  },
  "env": {
    "staging": {
      "name": "coin-archive-api-staging",
      "routes": [
        { "pattern": "api.staging.coinarchive.app", "custom_domain": true },
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "242",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "MAINTENANCE_READ_RATE_LIMITER",
          "namespace_id": "244",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "MAINTENANCE_MUTATION_RATE_LIMITER",
          "namespace_id": "245",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "DATABASE_URL",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
        ],
      },
      "vars": {
        "API_ENVIRONMENT": "staging",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://staging.coinarchive.app",
        "BETTER_AUTH_URL": "https://api.staging.coinarchive.app",
        "SURFACE_IMAGE_ORIGIN": "https://images.staging.coinarchive.app",
        "R2_BUCKET": "coin-archive-staging-surface-images",
        "R2_ENDPOINT": "https://51b6c859d0c0db14fc10e144dd033d2b.r2.cloudflarestorage.com",
      },
    },
    "production": {
      "name": "coin-archive-api",
      "routes": [{ "pattern": "api.coinarchive.app", "custom_domain": true }],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "242",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "MAINTENANCE_READ_RATE_LIMITER",
          "namespace_id": "244",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "MAINTENANCE_MUTATION_RATE_LIMITER",
          "namespace_id": "245",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "DATABASE_URL",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
        ],
      },
      "vars": {
        "API_ENVIRONMENT": "production",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://coinarchive.app",
        "BETTER_AUTH_URL": "https://api.coinarchive.app",
        "SURFACE_IMAGE_ORIGIN": "https://images.coinarchive.app",
        "R2_BUCKET": "coin-archive-production-surface-images",
        "R2_ENDPOINT": "https://51b6c859d0c0db14fc10e144dd033d2b.r2.cloudflarestorage.com",
      },
    },
  },
}
