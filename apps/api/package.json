{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "set -a; . ../../.env; set +a; wrangler dev --var \"DATABASE_URL:$DATABASE_URL\" --var \"API_ENVIRONMENT:staging\" --var \"SURFACE_IMAGE_ORIGIN:http://localhost:3000\"",
    "dev:staging": "if [ ! -f ../../.env.staging.local ]; then echo 'Missing .env.staging.local.'; exit 1; fi; wrangler dev --env staging --env-file ../../.env.staging.local",
    "dev:production": "if [ \"$ALLOW_PRODUCTION_DEBUG\" != \"true\" ]; then echo 'Refusing to connect the local API to production.'; exit 1; fi; if [ ! -f ../../.env.production.local ]; then echo 'Missing .env.production.local.'; exit 1; fi; wrangler dev --env production --env-file ../../.env.production.local",
    "build": "wrangler deploy --dry-run",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "validate:deployment:staging": "wrangler deploy --dry-run --env staging",
    "validate:deployment:production": "wrangler deploy --dry-run --env production",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@coin-archive/api": "workspace:*",
    "@coin-archive/db": "workspace:*",
    "@orpc/openapi": "^1.10.0",
    "@orpc/server": "^1.10.0",
    "@orpc/zod": "^1.10.0",
    "hono": "^4.12.25",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@tanstack/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.115.0"
  }
}
