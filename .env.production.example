# Copy to .env.production.local. The .local file is ignored by Git.
# Prefer read-only/least-privilege credentials unless reproducing a write failure.
DATABASE_URL=replace-with-production-direct-pooled-neon-url

# Keep the local URL. The Google OAuth client must allow the localhost callback.
BETTER_AUTH_SECRET=replace-with-production-debug-auth-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id-that-allows-localhost
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

VITE_AUTH_GOOGLE_ENABLED=true
VITE_SHOW_SIGN_IN_BUTTON=true
PUBLIC_API_BASE_URL=http://127.0.0.1:8787

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=coin-archive-production-surface-images
R2_ACCESS_KEY_ID=replace-with-production-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-production-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://images.coinarchive.app
