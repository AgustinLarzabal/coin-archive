{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "coin-archive-web",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "coinarchive.app", "custom_domain": true }],
  "services": [{ "binding": "API", "service": "coin-archive-api" }],
  "ratelimits": [
    {
      "name": "ARCHIVE_RATE_LIMIT",
      "namespace_id": "116",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "services": [{ "binding": "API", "service": "coin-archive-api-staging" }],
      "ratelimits": [
        {
          "name": "ARCHIVE_RATE_LIMIT",
          "namespace_id": "1161",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
    },
  },
}
