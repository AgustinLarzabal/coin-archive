{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coin-archive",
  "main": "./src/server.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["DATABASE_URL"] },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "243",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "services": [
    {
      "binding": "AUTH_API",
      "service": "coin-archive-api",
      "entrypoint": "AuthProxy",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  "env": {
    "staging": {
      "name": "coin-archive-staging",
      "routes": [
        { "pattern": "staging.coinarchive.app", "custom_domain": true },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "243",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "services": [
        {
          "binding": "AUTH_API",
          "service": "coin-archive-api-staging",
          "entrypoint": "AuthProxy",
        },
      ],
      "secrets": { "required": ["DATABASE_URL"] },
      "vars": { "CLOUDFLARE_ENV": "staging" },
    },
    "production": {
      "name": "coin-archive",
      "routes": [{ "pattern": "coinarchive.app", "custom_domain": true }],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "243",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "services": [
        {
          "binding": "AUTH_API",
          "service": "coin-archive-api",
          "entrypoint": "AuthProxy",
        },
      ],
      "secrets": { "required": ["DATABASE_URL"] },
      "vars": { "CLOUDFLARE_ENV": "production" },
    },
  },
}
